def backup(path, stamp):
    if path.exists():
        shutil.copy2(path, path.with_name(path.name + ".bak-ai-bridge-" + stamp))


def cmd_setup(args=()):
    model = ASTRA_MODEL
    if "--model" in args:
        i = list(args).index("--model")
        if i + 1 >= len(args):
            raise BridgeError("--model needs a model name, e.g. --model gpt-6.1-sol")
        model = args[i + 1]
    try:
        import tomllib
    except ImportError:
        raise BridgeError("setup needs Python 3.11+ (for tomllib)")
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    python = shutil.which("python3") or sys.executable

    for name in ("cx", "mem", "to-codex", "to-claude"):
        link = SCRIPT.parent / name
        if link.is_symlink() and link.resolve() == SCRIPT:
            continue
        if link.exists() or link.is_symlink():
            print("skip   %s exists and is not ours" % link)
            continue
        link.symlink_to(SCRIPT.name)
        print("linked %s" % link)

    CODEX_HOME.mkdir(exist_ok=True)
    INBOX.mkdir(parents=True, exist_ok=True)
    HANDOFFS.mkdir(parents=True, exist_ok=True)

    profile = CODEX_HOME / (ASTRA_PROFILE + ".config.toml")
    if not profile.exists() or "--model" in args:
        profile.write_text('model = "%s"\nmodel_reasoning_effort = "high"\n' % model)
        print("wrote  %s (model %s)" % (profile, model))

    # Codex: SessionStart hook
    hook_cmd = '"%s" "%s" codex-hook' % (python, SCRIPT)
    hooks_path = CODEX_HOME / "hooks.json"
    data = json.loads(hooks_path.read_text()) if hooks_path.exists() else {}
    starts = data.setdefault("hooks", {}).setdefault("SessionStart", [])
    ours = [h for group in starts for h in group.get("hooks", [])
            if "ai-bridge" in h.get("command", "") and "codex-hook" in h.get("command", "")]
    if ours:
        for h in ours:
            h["command"] = hook_cmd
    else:
        starts.append({"matcher": "startup|resume|clear|compact",
                       "hooks": [{"type": "command", "command": hook_cmd, "timeout": 15,
                                  "additionalContextLimit": 12000}]})
    rendered = json.dumps(data, indent=2) + "\n"
    if not hooks_path.exists() or hooks_path.read_text() != rendered:
        hooks_path.write_text(rendered)
        print("wrote  %s (Codex asks you to trust the changed hook once)" % hooks_path)

    # Codex: config.toml
    config = CODEX_HOME / "config.toml"
    text = config.read_text() if config.exists() else ""
    parsed = tomllib.loads(text)
    new = text
    if "project_doc_fallback_filenames" not in parsed:
        first_table = re.search(r"^\[", new, re.M)
        line = 'project_doc_fallback_filenames = ["CLAUDE.md"]\n'
        new = (new[:first_table.start()] + line + "\n" + new[first_table.start():]
               if first_table else line + new)
    roots = parsed.get("sandbox_workspace_write", {}).get("writable_roots", [])
    if "sandbox_workspace_write" not in parsed:
        new = new.rstrip("\n") + '\n\n[sandbox_workspace_write]\nwritable_roots = ["%s"]\n' % SHARED
    elif str(SHARED) not in roots:
        print("note   add %s to writable_roots under [sandbox_workspace_write] in %s"
              % (SHARED, config))
    if new != text:
        backup(config, stamp)
        config.write_text(new)
        print("edited %s (backup: config.toml.bak-ai-bridge-%s)" % (config, stamp))

    # Claude: SessionStart hook in user settings
    claude_cmd = '[ -f "%s" ] && "%s" "%s" claude-hook || true' % (SCRIPT, python, SCRIPT)
    settings = json.loads(CLAUDE_SETTINGS.read_text()) if CLAUDE_SETTINGS.exists() else {}
    starts = settings.setdefault("hooks", {}).setdefault("SessionStart", [])
    ours = [h for group in starts for h in group.get("hooks", [])
            if "ai-bridge" in h.get("command", "") and "claude-hook" in h.get("command", "")]
    if ours:
        changed = any(h["command"] != claude_cmd for h in ours)
        for h in ours:
            h["command"] = claude_cmd
    else:
        starts.append({"hooks": [{"type": "command", "command": claude_cmd, "timeout": 20}]})
        changed = True
    if changed:
        backup(CLAUDE_SETTINGS, stamp)
        CLAUDE_SETTINGS.write_text(json.dumps(settings, indent=2, ensure_ascii=False) + "\n")
        print("edited %s (backup: settings.json.bak-ai-bridge-%s)" % (CLAUDE_SETTINGS, stamp))

    # zsh: `codex` wrapper
    zsh = ZSHRC.read_text() if ZSHRC.exists() else ""
    start, end = zsh.find(ZSH_BEGIN), zsh.find(ZSH_END)
    if start >= 0 and end > start:
        new_zsh = zsh[:start] + ZSH_WRAPPER + zsh[end + len(ZSH_END):].lstrip("\n")
    else:
        new_zsh = zsh.rstrip("\n") + "\n\n" + ZSH_WRAPPER
    if new_zsh != zsh:
        backup(ZSHRC, stamp)
        ZSHRC.write_text(new_zsh)
        print("edited %s (open a new terminal, or run: source ~/.zshrc)" % ZSHRC)

    changed, notes = sync_mcp(HOME)
    for path in changed:
        print("synced Claude's MCP servers into %s" % path)
    for note in notes:
        print("note   %s" % note)
    print("\nDone.")
    return 0


def cmd_update():
    """Replace this script with the latest release."""
    import urllib.request
    try:
        data = urllib.request.urlopen(UPDATE_URL, timeout=20).read()
    except Exception as exc:  # noqa: BLE001
        raise BridgeError("download failed: %s" % exc)
    compile(data, str(SCRIPT), "exec")  # refuse to install a broken script
    m = re.search(rb'^VERSION = "([^"]+)"', data, re.M)
    new = m.group(1).decode() if m else "?"
    if new == VERSION:
        print("ai-bridge %s is already the latest" % VERSION)
        return 0
    tmp = SCRIPT.with_name(SCRIPT.name + ".new")
    tmp.write_bytes(data)
    os.chmod(str(tmp), 0o755)
    os.replace(str(tmp), str(SCRIPT))
    print("ai-bridge updated %s -> %s" % (VERSION, new))
    return 0


# ---------------------------------------------------------------- main

def main(argv):
    prog = Path(argv[0]).name
    args = argv[1:]
    if prog == "ai-bridge":
        if not args or args[0] in ("-h", "--help", "help"):
            print(__doc__.strip())
            return 0
        if args[0] in ("-V", "--version"):
            print("ai-bridge " + VERSION)
            return 0
        prog, args = args[0], args[1:]
    if prog != "cx" and args[:1] in (["-h"], ["--help"]):
        print(__doc__.strip())
        return 0
    commands = {
        "to-codex": cmd_to_codex,
        "to-claude": cmd_to_claude,
        "mem": cmd_mem,
        "sync": cmd_sync,
        "claude-transcript": cmd_claude_transcript,
        "codex-transcript": cmd_codex_transcript,
    }
    if prog == "cx":
        return launch(["codex", "-p", ASTRA_PROFILE] + args, Path.cwd(), False)
    if prog in commands:
        return commands[prog](args)
    if prog == "codex-hook":
        return cmd_codex_hook()
    if prog == "claude-hook":
        return cmd_claude_hook()
    if prog == "setup":
        return cmd_setup(args)
    if prog == "update":
        return cmd_update()
    raise BridgeError("unknown command: %s (see ai-bridge --help)" % prog)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except BridgeError as exc:
        sys.stderr.write("%s: %s\n" % (Path(sys.argv[0]).name, exc))
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
