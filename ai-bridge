                  if d.is_dir() and d.name != key and pending(d.name)] if INBOX.is_dir() else []
        if others:
            print("Other projects with new Codex memories: %d (`mem pull --all`)" % len(others))
        return 0
    if sub == "pull":
        dry = "-n" in args or "--dry-run" in args
        if "--all" in args:
            keys = sorted(d.name for d in INBOX.iterdir() if d.is_dir()) if INBOX.is_dir() else []
