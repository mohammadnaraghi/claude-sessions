#!/usr/bin/env python3
"""ai-bridge - shared memory, MCP servers and sessions between Claude Code and Codex.

Part of sessions (https://github.com/mohammadnaraghi/sessions), next to the `s` picker.
Nothing to run day to day once set up: start `claude` or `codex` as usual.
  - Codex sees Claude's memories for the folder (a Codex SessionStart hook), and
    saves what it learns to an inbox in Claude's memory format.
  - Claude pulls that inbox into its memory when it starts (a Claude
    SessionStart hook), and is told about the latest Codex session in the
    folder; Codex is told about the latest Claude session. Say "continue where
    Codex/Claude left off" and they read the other's transcript.
  - Claude's MCP servers are copied into Codex's config (user scope into
    ~/.codex/config.toml, a project's .mcp.json and local servers into
    <project>/.codex/config.toml). Add or remove MCP servers in Claude.
  - In zsh, `codex` starts the bridge's Codex profile (GPT-6 Astra unless setup
    was given --model) unless you pass -p/--profile or -m/--model; `s` uses it
    too (SESSIONS_CODEX_ARGS).

Optional commands
  cx [codex args]       same as `codex` with the bridge's profile
  to-codex [id|path]    resume this folder's latest Claude session as a real
                        Codex thread (full history, via Codex's importer)
  to-claude [thread]    continue this folder's latest Codex session in Claude
  mem                   shared-memory status for this folder
  mem pull [-n] [--all] copy Codex's new memories into Claude's memory now
  mem show              print exactly what Codex is given at session start
  ai-bridge sync        copy Claude's MCP servers into Codex now
  ai-bridge claude-transcript [id] / codex-transcript [thread]
                        print a session as markdown (what the tools read)

  --print on to-codex / to-claude prints the command instead of running it.

Setup (idempotent; every file it edits is backed up as *.bak-ai-bridge-<time>)
  ai-bridge setup [--model M]
                        links cx/mem/to-codex/to-claude next to this script,
                        writes ~/.codex/astra.config.toml (model M, default
                        gpt-6-astra), the Codex hook (~/.codex/hooks.json),
                        the Claude hook (~/.claude/settings.json), the zsh
                        `codex` wrapper (~/.zshrc), and Codex config.toml
                        settings
  ai-bridge update      replace this script with the latest release
                        (`s update` does it too)

Files
  ~/.claude/projects/<project>/memory/     Claude's memory; Codex reads it
  ~/.codex/shared-memory/inbox/<project>/  memories Codex saved, until pulled
  ~/.codex/shared-memory/handoffs/         Codex transcripts handed to Claude
"""

import datetime
import json
import os
import re
import select
import shutil
import subprocess
import sys
import time
from pathlib import Path

VERSION = "0.3.0"
UPDATE_URL = "https://raw.githubusercontent.com/mohammadnaraghi/sessions/main/ai-bridge"
HOME = Path.home()
CLAUDE_PROJECTS = HOME / ".claude" / "projects"
CLAUDE_JSON = HOME / ".claude.json"
CLAUDE_SETTINGS = HOME / ".claude" / "settings.json"
CODEX_HOME = Path(os.environ.get("CODEX_HOME") or HOME / ".codex")
SHARED = CODEX_HOME / "shared-memory"
INBOX = SHARED / "inbox"
HANDOFFS = SHARED / "handoffs"
ZSHRC = HOME / ".zshrc"
SCRIPT = Path(__file__).resolve()
ASTRA_PROFILE = "astra"
ASTRA_MODEL = "gpt-6-astra"
INDEX_MAX_LINES = 200  # Claude loads the first 200 lines or 25KB of MEMORY.md
INDEX_MAX_BYTES = 25_000
HANDOFF_MAX_CHARS = 60_000
IMPORT_MAX_TOKENS = 150_000  # bigger Claude conversations go to Codex as summary + recent part
RECENT_DAYS = 14
SAFE_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*\.md$")
MCP_BEGIN = "# >>> ai-bridge: MCP servers copied from Claude Code (edit them in Claude) >>>"
MCP_END = "# <<< ai-bridge MCP <<<"
ZSH_BEGIN = "# >>> ai-bridge >>>"
ZSH_END = "# <<< ai-bridge <<<"
SKIP_PREFIX = (
    "<task-notification>", "<system-reminder>", "[Request interrupted",
    "<artifact-content", "<local-command", "<command-name>", "<command-message>",
    "<command-args>", "<bash-input>", "<bash-stdout>", "<bash-stderr>", "Caveat:",
    "This session is being continued", "<ide_opened_file>", "<ide_selection>",
)


class BridgeError(Exception):
    pass


# ---------------------------------------------------------------- projects

def project_key(path):
    """Claude Code's folder name under ~/.claude/projects for a path."""
    return re.sub(r"[^A-Za-z0-9]", "-", str(path))


def find_project_dir(key):
    exact = CLAUDE_PROJECTS / key
    if exact.is_dir() or len(key) <= 140:
        return exact
    # Claude shortens very long names; match on the kept prefix.
    matches = sorted(CLAUDE_PROJECTS.glob(key[:140] + "*"))
    return matches[0] if matches else exact


def git(cwd, *args):
    try:
        out = subprocess.run(["git", "-C", str(cwd), *args], capture_output=True,
                             text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return out.stdout.strip() if out.returncode == 0 else None


def project_root(cwd):
    """The folder Claude keys auto memory on: the main repo root (shared by
    worktrees and subfolders), or the folder itself outside git."""
    common = git(cwd, "rev-parse", "--path-format=absolute", "--git-common-dir")
    if common and Path(common).name == ".git":
        return Path(common).parent
    top = git(cwd, "rev-parse", "--show-toplevel")
    return Path(top) if top else Path(cwd)


def worktree_root(cwd):
    """The checkout Codex treats as the project (where .codex/ lives)."""
    top = git(cwd, "rev-parse", "--show-toplevel")
    return Path(top) if top else Path(cwd)


def memory_dir(root):
    return find_project_dir(project_key(root)) / "memory"


def ago(ts):
    secs = max(0, time.time() - ts)
    for unit, size in (("day", 86400), ("hour", 3600), ("minute", 60)):
        if secs >= size:
            n = int(secs // size)
            return "%d %s%s ago" % (n, unit, "" if n == 1 else "s")
    return "just now"


# ---------------------------------------------------------------- memory files

def frontmatter(text):
    if not text.startswith("---\n"):
        return None
    end = text.find("\n---", 4)
    if end < 0:
        return None
    block = text[4:end]

    def field(pattern):
        m = re.search(pattern, block, re.M)
        return m.group(1).strip().strip("'\"") if m else ""

    return {
        "name": field(r"^name:\s*(.+)$"),
        "description": field(r"^description:\s*(.+)$"),
        "type": field(r"^\s+type:\s*(\S+)") or field(r"^type:\s*(\S+)"),
    }


def index_title(name):
    words = name.replace("_", "-").split("-")
    text = " ".join(w for w in words if w)
    return text[:1].upper() + text[1:]


def read_index(mem):
    path = mem / "MEMORY.md"
    if not path.is_file():
        return ""
    data = path.read_bytes()[:INDEX_MAX_BYTES].decode("utf-8", "ignore")
    return "\n".join(data.splitlines()[:INDEX_MAX_LINES]).strip()


def pending(key):
    folder = INBOX / key
    if not folder.is_dir():
        return []
    out = []
    for f in sorted(folder.glob("*.md")):
        meta = frontmatter(f.read_text(errors="ignore")) or {}
        out.append((f, meta))
    return out


def add_source(text):
    if re.search(r"^\s+source:\s*codex\s*$", text, re.M):
        return text
    if re.search(r"^metadata:\s*$", text, re.M):
        return re.sub(r"^metadata:\s*$", "metadata:\n  source: codex", text, count=1, flags=re.M)
    return text


def update_index(mem, fname, line):
    path = mem / "MEMORY.md"
    lines = path.read_text().splitlines() if path.is_file() else ["# Memory index", ""]
    link = "](" + fname + ")"
    for i, existing in enumerate(lines):
        if link in existing:
            lines[i] = line
            break
    else:
        lines.append(line)
    path.write_text("\n".join(lines).rstrip("\n") + "\n")


def pull(keys, dry_run, quiet=False):
    """Copy inbox memories into Claude's memory. Returns the index lines pulled."""
    say = (lambda *a: None) if quiet else print
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    pulled = []
    for key in keys:
        items = pending(key)
        if not items:
            continue
        mem = find_project_dir(key) / "memory"
        say(("Would pull into " if dry_run else "Pulling into ") + str(mem))
        for src, meta in items:
            if src.name == "MEMORY.md" or not SAFE_NAME.match(src.name):
                say("  skip    %s (not a memory file name)" % src.name)
                continue
            if not meta or not meta["name"] or not meta["description"]:
                say("  skip    %s (needs name and description frontmatter)" % src.name)
                continue
            text = add_source(src.read_text())
            dest = mem / src.name
            if not dest.exists():
                action = "new"
            elif dest.read_text() == text:
                action = "same"
            else:
                action = "update"
            say("  %-7s %s — %s" % (action, src.name, meta["description"]))
            if dry_run:
                continue
            mem.mkdir(parents=True, exist_ok=True)
            if action == "update":
                backup = HOME / ".claude" / "backups" / ("mem-pull-" + stamp) / key
                backup.mkdir(parents=True, exist_ok=True)
                shutil.copy2(dest, backup / dest.name)
            if action != "same":
                dest.write_text(text)
            line = "- [%s](%s) — %s" % (index_title(meta["name"]), src.name, meta["description"])
            update_index(mem, src.name, line)
            done = INBOX / key / ".pulled"
            done.mkdir(exist_ok=True)
            src.rename(done / (stamp + "-" + src.name))
            pulled.append(line)
    if not dry_run:
        say("Pulled %d memor%s into Claude." % (len(pulled), "y" if len(pulled) == 1 else "ies"))
    return pulled


# ---------------------------------------------------------------- Claude sessions

def claude_sessions(cwd):
    """This folder's Claude transcripts, newest first."""
    dirs = dict.fromkeys([find_project_dir(project_key(cwd)),
                          find_project_dir(project_key(project_root(cwd)))])
    files = [f for d in dirs if d.is_dir() for f in d.glob("*.jsonl")]
    return sorted(files, key=lambda f: f.stat().st_mtime, reverse=True)


def claude_title(path):
    """(title, has_conversation) from the end of a transcript."""
    size = path.stat().st_size
    with open(path, "rb") as fh:
        fh.seek(max(0, size - 512_000))
        tail = fh.read().decode("utf-8", "ignore")
    ai = custom = None
    talked = '"type":"assistant"' in tail
    for line in tail.splitlines():
        if '"ai-title"' not in line and '"custom-title"' not in line:
            continue
        try:
            o = json.loads(line)
        except ValueError:
            continue
        if o.get("type") == "ai-title":
            ai = o.get("aiTitle") or ai
        elif o.get("type") == "custom-title":
            custom = o.get("customTitle") or custom
    return custom or ai, talked or bool(custom or ai)


def latest_claude_session(cwd):
    for path in claude_sessions(cwd)[:8]:
        title, talked = claude_title(path)
        if talked:
            return path, title
    return None, None


def find_claude_session(arg, cwd):
    if arg:
        if arg.endswith(".jsonl"):
            path = Path(arg).expanduser().resolve()
            if path.is_file():
                return path
            raise BridgeError("no such file: %s" % path)
        hits = list(CLAUDE_PROJECTS.glob("*/%s.jsonl" % arg))
        if not hits:
            raise BridgeError("no Claude session with id %s" % arg)
        return hits[0]
    path, _ = latest_claude_session(cwd)
    if not path:
        raise BridgeError("no Claude session found for %s" % cwd)
    return path


def session_cwd(path):
    with open(path, errors="ignore") as fh:
        for i, line in enumerate(fh):
            if i > 200:
                break
            try:
                cwd = json.loads(line).get("cwd")
            except ValueError:
                continue
            if cwd:
                return Path(cwd)
    return None


def claude_text(content):
    if isinstance(content, str):
        return content
    return "\n".join(b.get("text", "") for b in content or []
                     if isinstance(b, dict) and b.get("type") == "text")


def tool_brief(block):
    args = block.get("input") or {}
    for key in ("command", "file_path", "path", "pattern", "url", "query", "description"):
        value = args.get(key)
        if isinstance(value, str) and value.strip():
            return "%s: %s" % (block.get("name"), " ".join(value.split())[:200])
    return block.get("name") or "a tool"


def render_claude(path):
    entries = []
    with open(path, errors="ignore") as fh:
        for line in fh:
            if '"type":"user"' not in line and '"type":"assistant"' not in line:
                continue
            try:
                o = json.loads(line)
            except ValueError:
                continue
            if o.get("isSidechain") or o.get("isMeta"):
                continue
            msg = o.get("message") or {}
            content = msg.get("content")
            if o.get("type") == "user":
                if isinstance(content, list) and any(
                        isinstance(b, dict) and b.get("type") == "tool_result" for b in content):
                    continue
                text = claude_text(content).strip()
                if text and not text.startswith(SKIP_PREFIX):
                    entries.append("**You:** " + text)
            elif o.get("type") == "assistant" and isinstance(content, list):
                for b in content:
                    if not isinstance(b, dict):
                        continue
                    if b.get("type") == "text" and b.get("text", "").strip():
                        entries.append("**Claude:** " + b["text"].strip())
                    elif b.get("type") == "tool_use":
                        entries.append("- used " + tool_brief(b))
    kept, size = [], 0
    for entry in reversed(entries):
        if size + len(entry) > HANDOFF_MAX_CHARS and kept:
            break
        kept.append(entry)
        size += len(entry)
    return list(reversed(kept)), len(kept) < len(entries)


def cmd_claude_transcript(args):
    cwd = Path.cwd().resolve()
    path = find_claude_session(args[0] if args else None, cwd)
    title, _ = claude_title(path)
    blocks, more = render_claude(path)
    header = ["# Claude Code session", "",
              "- Session: %s (`%s`)" % (title or "untitled", path.stem),
              "- Folder: %s" % (session_cwd(path) or "?"),
              "- Last active: %s" % datetime.datetime.fromtimestamp(
                  path.stat().st_mtime).strftime("%Y-%m-%d %H:%M")]
    if more:
        header.append("- Earlier turns are left out; the full transcript: %s" % path)
    sys.stdout.write("\n".join(header) + "\n\n---\n\n" + "\n\n".join(blocks) + "\n")
    return 0


# ---------------------------------------------------------------- codex app-server

class AppServer:
    """Minimal JSON-RPC client for `codex app-server` over stdio."""

    def __init__(self, cwd, timeout=60):
        try:
            self.proc = subprocess.Popen(["codex", "app-server"], cwd=str(cwd),
                                         stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                         stderr=subprocess.DEVNULL)
        except OSError:
            raise BridgeError("codex is not installed (npm install -g @openai/codex)")
        self.fd = self.proc.stdout.fileno()
        self.buf = b""
        self.next_id = 0
        self.notes = []
        self.request("initialize", {
            "clientInfo": {"name": "ai-bridge", "title": "ai-bridge", "version": VERSION},
            "capabilities": {"experimentalApi": False}}, timeout=timeout)
        self.send({"method": "initialized", "params": {}})

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        self.proc.terminate()
        try:
            self.proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            self.proc.kill()

    def send(self, msg):
        self.proc.stdin.write((json.dumps(msg) + "\n").encode())
        self.proc.stdin.flush()

    def read(self, deadline):
        while True:
            while b"\n" not in self.buf:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise BridgeError("timed out waiting for codex app-server")
                ready, _, _ = select.select([self.fd], [], [], remaining)
                if not ready:
                    continue
                chunk = os.read(self.fd, 65536)
                if not chunk:
                    raise BridgeError("codex app-server exited unexpectedly")
                self.buf += chunk
            line, self.buf = self.buf.split(b"\n", 1)
            if line.strip():
                return json.loads(line)

    def handle(self, msg):
        if "id" in msg and "method" in msg:  # a request from the server; we take none
            self.send({"id": msg["id"],
                       "error": {"code": -32601, "message": "unsupported: " + msg["method"]}})
        elif "method" in msg:
            self.notes.append(msg)

    def request(self, method, params, timeout=60):
        self.next_id += 1
        rid = self.next_id
        self.send({"id": rid, "method": method, "params": params})
        deadline = time.monotonic() + timeout
        while True:
            msg = self.read(deadline)
            if msg.get("id") == rid and "method" not in msg:
                if "error" in msg:
                    raise BridgeError("codex %s failed: %s" % (
                        method, msg["error"].get("message", msg["error"])))
                return msg.get("result") or {}
            self.handle(msg)

    def wait_for(self, method, timeout):
        deadline = time.monotonic() + timeout
        while True:
            for note in self.notes:
                if note.get("method") == method:
                    self.notes.remove(note)
                    return note.get("params") or {}
            self.handle(self.read(deadline))


# ---------------------------------------------------------------- Codex sessions

def item_lines(item):
    kind = item.get("type")
    if kind == "userMessage":
        text = "\n".join(c.get("text", "") for c in item.get("content") or []
                         if c.get("type") == "text").strip()
        return ["**You:** " + text] if text else []
    if kind == "agentMessage" and item.get("text"):
        return ["**Codex:** " + item["text"].strip()]
    if kind == "plan" and item.get("text"):
        return ["**Plan:**\n" + item["text"].strip()]
    if kind == "commandExecution":
        actions = item.get("commandActions") or []
        cmd = (actions[0].get("command") if actions else None) or item.get("command") or ""
        code = item.get("exitCode")
        tail = " (exit %s)" % code if code not in (0, None) else ""
        return ["- ran `%s`%s" % (" ".join(cmd.split())[:300], tail)]
    if kind == "fileChange":
        paths = [c.get("path") for c in item.get("changes") or [] if c.get("path")]
        return ["- changed " + ", ".join(paths)] if paths else []
    if kind == "mcpToolCall":
        return ["- used %s.%s" % (item.get("server"), item.get("tool"))]
    if kind == "webSearch" and item.get("query"):
        return ["- searched the web: " + item["query"]]
    if kind == "contextCompaction":
        return ["- (context was compacted here)"]
    return []  # hookPrompt (our memory block), reasoning, tool plumbing


def render_turns(srv, thread_id):
    blocks, size, cursor, more = [], 0, None, False
    while True:
        params = {"threadId": thread_id, "limit": 25, "itemsView": "full",
                  "sortDirection": "desc"}
        if cursor:
            params["cursor"] = cursor
        page = srv.request("thread/turns/list", params)
        for turn in page.get("data") or []:
            lines = [l for item in turn.get("items") or [] for l in item_lines(item)]
            if not lines:
                continue
            block = "\n\n".join(lines)
            if size + len(block) > HANDOFF_MAX_CHARS and blocks:
                more = True
                break
            blocks.append(block)
            size += len(block)
        cursor = page.get("nextCursor")
        if more or not cursor:
            more = more or bool(cursor)
            break
    blocks.reverse()
    return blocks, more


def find_codex_thread(srv, cwd, thread_id=None):
    if thread_id:
        return srv.request("thread/read", {"threadId": thread_id}).get("thread")
    for folder in dict.fromkeys([str(cwd), str(project_root(cwd))]):
        found = srv.request("thread/list", {
            "limit": 1, "cwd": [folder], "sortKey": "updated_at",
            "sortDirection": "desc"}, timeout=10).get("data") or []
        if found:
            return found[0]
    return None


def thread_title(thread):
    if thread.get("name"):
        return thread["name"]
    lines = (thread.get("preview") or "").strip().splitlines()
    return lines[0][:80] if lines else "untitled"


def codex_transcript(cwd, thread_id=None):
    """(markdown, thread, folder) for this folder's latest Codex session."""
    with AppServer(cwd) as srv:
        thread = find_codex_thread(srv, cwd, thread_id)
        if not thread:
            raise BridgeError("no Codex session found for %s" % cwd)
        blocks, more = render_turns(srv, thread["id"])
    work = Path(thread.get("cwd") or cwd)
    if not work.is_dir():
        work = cwd
    when = datetime.datetime.fromtimestamp(thread.get("updatedAt") or time.time())
    header = ["# Codex session", "",
              "- Session: %s (`%s`)" % (thread_title(thread), thread["id"]),
              "- Folder: %s" % work,
              "- Model: %s %s" % (thread.get("model") or "?", thread.get("reasoningEffort") or ""),
              "- Last active: %s" % when.strftime("%Y-%m-%d %H:%M")]
    if more:
        header.append("- Earlier turns are left out; the full session: `codex resume %s`"
                      % thread["id"])
    text = "\n".join(header) + "\n\n---\n\n" + "\n\n---\n\n".join(blocks) + "\n"
    return text, thread, work


def cmd_codex_transcript(args):
    text, _, _ = codex_transcript(Path.cwd().resolve(), args[0] if args else None)
    sys.stdout.write(text)
    return 0


# ---------------------------------------------------------------- MCP servers

VAR_ONLY = re.compile(r"^\$\{([A-Za-z_][A-Za-z0-9_]*)\}$")


def toml_key(key):
    return key if re.match(r"^[A-Za-z0-9_-]+$", key) else json.dumps(key, ensure_ascii=False)


def toml_value(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    if isinstance(value, str):
        return json.dumps(value, ensure_ascii=False)
    if isinstance(value, list):
        return "[" + ", ".join(toml_value(v) for v in value) + "]"
    if isinstance(value, dict):
        return "{ " + ", ".join("%s = %s" % (toml_key(k), toml_value(v))
                                for k, v in value.items()) + " }"
    raise ValueError("can't write %r as TOML" % (value,))


def codex_server(cfg, cwd=None):
    """Claude MCP config -> (Codex config, None) or (None, why it can't be shared)."""
    kind = cfg.get("type") or ("http" if cfg.get("url") else "stdio")
    if kind == "sse":
        return None, "SSE servers don't work in Codex"
    if kind == "stdio":
        command = cfg.get("command")
        args = [str(a) for a in cfg.get("args") or []]
        env = {k: str(v) for k, v in (cfg.get("env") or {}).items()}
        if not command:
            return None, "no command"
        if "${" in command or any("${" in s for s in args + list(env.values())):
            return None, "uses ${VAR}, which Codex doesn't expand"
        out = {"command": command}
        if args:
            out["args"] = args
        if env:
            out["env"] = env
        if cwd:
            out["cwd"] = str(cwd)
        return out, None
    if kind == "http":
        url = cfg.get("url") or ""
        if not url or "${" in url:
            return None, "no usable url"
        out = {"url": url}
        headers, env_headers = {}, {}
        for name, value in (cfg.get("headers") or {}).items():
            value = str(value)
            bearer = re.match(r"^Bearer \$\{([A-Za-z_][A-Za-z0-9_]*)\}$", value)
            if bearer and name.lower() == "authorization":
                out["bearer_token_env_var"] = bearer.group(1)
            elif VAR_ONLY.match(value):
                env_headers[name] = VAR_ONLY.match(value).group(1)
            elif "${" in value:
                return None, "header %s uses ${VAR}, which Codex doesn't expand" % name
            else:
                headers[name] = value
        if headers:
            out["http_headers"] = headers
        if env_headers:
            out["env_http_headers"] = env_headers
        return out, None
    return None, "unknown server type %s" % kind


def claude_mcp(cwd):
    """(user servers, project servers, project folder) as Claude sees them from cwd."""
    try:
        data = json.loads(CLAUDE_JSON.read_text())
    except (OSError, ValueError):
        data = {}
    top = worktree_root(cwd)
    projects = data.get("projects") or {}
    places = list(dict.fromkeys([str(top), str(cwd)]))
    disabled = set()
    for place in places:
        disabled.update((projects.get(place) or {}).get("disabledMcpjsonServers") or [])
    project = {}
    for place in places:  # .mcp.json (project scope)
        try:
            servers = json.loads((Path(place) / ".mcp.json").read_text()).get("mcpServers") or {}
        except (OSError, ValueError, AttributeError):
            continue
        project.update({k: v for k, v in servers.items() if k not in disabled})
    for place in places:  # `claude mcp add` without --scope (local scope)
        project.update((projects.get(place) or {}).get("mcpServers") or {})
    return data.get("mcpServers") or {}, project, top


def write_mcp_block(path, servers, notes):
    """Rewrite our marked block in a Codex config.toml. Returns True if changed."""
    import tomllib
    text = path.read_text() if path.exists() else ""
    start, end = text.find(MCP_BEGIN), text.find(MCP_END)
    if start >= 0 and end > start:
        rest = text[end + len(MCP_END):].lstrip("\n")
        base = text[:start].rstrip("\n") + ("\n\n" + rest if rest else "\n")
    else:
        base = text
    taken = set((tomllib.loads(base).get("mcp_servers") or {}).keys())
    lines = []
    for name, cfg in servers.items():
        if name in taken:
            notes.append("%s: %s already defines it, left as is" % (name, path))
            continue
        lines.append("[mcp_servers.%s]" % toml_key(name))
        lines += ["%s = %s" % (toml_key(k), toml_value(v)) for k, v in cfg.items()]
        lines.append("")
    if lines:
        block = "\n".join([MCP_BEGIN] + lines + [MCP_END]) + "\n"
        new = (base.rstrip("\n") + "\n\n" if base.strip() else "") + block
    else:
        new = base if base.strip() else ""
    if new == text:
        return False
    tomllib.loads(new)  # never leave Codex a config it can't read
    if not new:
        path.unlink()
        return True
    tmp = path.with_name(path.name + ".ai-bridge-tmp")
    tmp.write_text(new)
    if path.exists():
        shutil.copymode(path, tmp)
    else:
        os.chmod(tmp, 0o600)
    os.replace(tmp, path)
    return True


def git_exclude(top, pattern):
    if git(top, "check-ignore", "-q", pattern.lstrip("/")) is not None:
        return
    exclude = git(top, "rev-parse", "--path-format=absolute", "--git-path", "info/exclude")
    if not exclude:
        return
    path = Path(exclude)
    current = path.read_text() if path.exists() else ""
    if pattern in current.split("\n"):
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "a") as fh:
        fh.write(("" if current.endswith("\n") or not current else "\n")
                 + "# ai-bridge: Codex config made from Claude's .mcp.json\n" + pattern + "\n")


def sync_mcp(cwd):
    """Copy Claude's MCP servers into Codex. Returns (changed files, notes)."""
    user, project, top = claude_mcp(cwd)
    changed, notes = [], []

    def convert(servers, where):
        out = {}
        for name, cfg in servers.items():
            conv, why = codex_server(cfg, where)
            if conv:
                out[name] = conv
            else:
                notes.append("%s: not shared (%s)" % (name, why))
        return out

    global_cfg = CODEX_HOME / "config.toml"
    local_cfg = top / ".codex" / "config.toml"
    servers = convert(project, top)
    same = local_cfg.resolve() == global_cfg.resolve()  # in ~, .codex is Codex's home
    if write_mcp_block(global_cfg, dict(convert(user, None), **servers) if same
                       else convert(user, None), notes):
        changed.append(global_cfg)

    if not same and (servers or local_cfg.exists()):
        if git(top, "ls-files", "--error-unmatch", ".codex/config.toml") is not None:
            notes.append("%s is tracked in git; not touching it" % local_cfg)
        else:
            if servers:
                local_cfg.parent.mkdir(exist_ok=True)
                git_exclude(top, "/.codex/config.toml")
            if write_mcp_block(local_cfg, servers, notes):
                changed.append(local_cfg)
            if not local_cfg.exists() and local_cfg.parent.is_dir() \
                    and not any(local_cfg.parent.iterdir()):
                local_cfg.parent.rmdir()
    return changed, notes


def cmd_sync(args):
    quiet = "--quiet" in args or "-q" in args
    changed, notes = sync_mcp(Path.cwd().resolve())
    if not quiet:
        user, project, _ = claude_mcp(Path.cwd().resolve())
        print("Claude MCP servers: %s" % (", ".join(user) or "none"))
        if project:
            print("This project's servers: %s" % ", ".join(project))
        for path in changed:
            print("updated %s" % path)
        for note in notes:
            print("note    %s" % note)
        if not changed:
            print("Codex already has them.")
    return 0


