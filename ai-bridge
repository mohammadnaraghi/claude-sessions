def codex_context(cwd):
    root = project_root(cwd)
    key = project_key(root)
    mem = memory_dir(root)
    inbox = INBOX / key
    inbox.mkdir(parents=True, exist_ok=True)

    parts = ["# Shared memory with Claude Code",
             "The user also works with Claude Code in this folder, and you two share "
             "long-term memory. Use it the way Claude does: as background that may be "
             "out of date, so check a memory against the current state before acting on it."]

    global_md = HOME / ".claude" / "CLAUDE.md"
    if global_md.is_file():
        parts += ["## The user's global instructions (~/.claude/CLAUDE.md)",
                  global_md.read_text(errors="ignore").strip()]

    index = read_index(mem)
    parts.append("## Claude's memories for this project")
    if index:
        parts += ["Folder: %s/ (read-only for you: never edit or delete files there)." % mem,
                  "Each line below points to a topic file in that folder. Read the file "
                  "(cat it) when it is relevant, before relying on it.",
                  index]
    else:
        parts.append("Claude has no memories for this project yet.")

    mine = pending(key)
    if mine:
        parts.append("## Memories you saved earlier (Claude gets them next time it starts here)")
        parts += ["- %s — %s" % (f.name, m.get("description", "")) for f, m in mine]

    path, title = latest_claude_session(cwd)
    if path and time.time() - path.stat().st_mtime < RECENT_DAYS * 86400:
        parts += ["## The user's latest Claude Code session here",
                  "\"%s\", last active %s. If the user wants to continue it, or asks what "
                  "Claude did, read it with: %s claude-transcript %s"
                  % (title or "untitled", ago(path.stat().st_mtime), SCRIPT, path.stem)]

    parts += [
        "## Saving memories",
        "When you learn something worth keeping for future sessions, save it without "
        "being asked, and say so in one line. Write one file per memory to "
        "%s/<short-kebab-name>.md in exactly this format:" % inbox,
        "---\nname: <short-kebab-name>\ndescription: <one line, used later to decide "
        "relevance>\nmetadata:\n  type: user | feedback | project | reference\n---\n\n"
        "<the fact. For feedback and project memories, follow it with **Why:** and "
        "**How to apply:** lines.>",
        "Types: user = who the user is and how they like to work; feedback = corrections "
        "and approaches they confirmed, with the reason; project = ongoing work, "
        "decisions and deadlines the code and git history don't show (write absolute "
        "dates); reference = where to find things outside the project. Don't save what "
        "the code, git history, AGENTS.md or CLAUDE.md already say, or anything only "
        "useful in this conversation. Never save secrets, tokens or passwords.",
        "To correct or extend one of Claude's memories, write the full new version to "
        "the inbox under the same file name. Before creating a memory, check the lists "
        "above so you update an existing one instead of duplicating it.",
        "Claude copies the inbox into its memory folder when it next starts here. Do "
        "not write to Claude's memory folder yourself.",
    ]
    return "\n\n".join(parts) + "\n"


def hook_payload():
    try:
        return json.loads(sys.stdin.read() or "{}")
    except ValueError:
        return {}


def cmd_codex_hook():
    cwd = Path(hook_payload().get("cwd") or os.getcwd())
    try:
        sync_mcp(cwd)  # takes effect from Codex's next start
    except Exception as exc:
        sys.stderr.write("ai-bridge mcp sync: %s\n" % exc)
    try:
        sys.stdout.write(codex_context(cwd))
    except Exception as exc:  # never block Codex from starting
        sys.stderr.write("ai-bridge hook: %s\n" % exc)
    return 0


def cmd_claude_hook():
    cwd = Path(hook_payload().get("cwd") or os.getcwd())
    parts = []
    try:
        pulled = pull([project_key(project_root(cwd))], dry_run=False, quiet=True)
        if pulled:
            parts.append("Codex (GPT), which the user also uses here, saved these memories "
                         "since your last session. They are now in your memory folder:\n"
                         + "\n".join(pulled))
    except Exception as exc:
        sys.stderr.write("ai-bridge pull: %s\n" % exc)
    try:
        sync_mcp(cwd)
    except Exception as exc:
        sys.stderr.write("ai-bridge mcp sync: %s\n" % exc)
    try:
        with AppServer(cwd, timeout=5) as srv:
            thread = find_codex_thread(srv, cwd)
        if thread and time.time() - (thread.get("updatedAt") or 0) < RECENT_DAYS * 86400:
            parts.append("The user also works with Codex (GPT) in this folder. Their latest "
                         "Codex session: \"%s\", last active %s. If the user wants to "
                         "continue it, or asks what Codex did, read it with: %s "
                         "codex-transcript %s"
                         % (thread_title(thread), ago(thread["updatedAt"]), SCRIPT,
                            thread["id"]))
    except Exception:
        pass  # Codex missing or slow: nothing to report
    if parts:
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart",
                                                 "additionalContext": "\n\n".join(parts)}}))
    return 0


# ---------------------------------------------------------------- to-codex / to-claude

def imported_thread(source):
    ledger = CODEX_HOME / "external_agent_session_imports.json"
    try:
        records = json.loads(ledger.read_text()).get("records") or []
    except (OSError, ValueError):
        return None
    ids = [r.get("imported_thread_id") for r in records
           if r.get("source_path") == str(source) and r.get("imported_thread_id")]
    return ids[-1] if ids else None


def claude_size(path):
    """(estimated tokens of a Claude conversation, Claude's latest compaction summary)."""
    chars, summary = 0, None
    with open(path, errors="ignore") as fh:
        for line in fh:
            if '"type":"user"' not in line and '"type":"assistant"' not in line:
                continue
            try:
                o = json.loads(line)
            except ValueError:
                continue
            if o.get("type") not in ("user", "assistant") or o.get("isSidechain"):
                continue
            content = (o.get("message") or {}).get("content")
            if o.get("isCompactSummary"):
                summary = claude_text(content)
            blocks = [{"type": "text", "text": content}] if isinstance(content, str) else content or []
            for b in blocks:
                if not isinstance(b, dict):
                    continue
                if b.get("type") == "text":
                    chars += len(b.get("text") or "")
                elif b.get("type") == "tool_use":
                    chars += len(json.dumps(b.get("input")))
                elif b.get("type") == "tool_result":
                    body = b.get("content")
                    chars += len(body if isinstance(body, str) else json.dumps(body))
    return chars // 4, summary


def claude_handoff(source, summary):
    """Claude's summary of the earlier work plus the recent part, for Codex to read. -> path."""
    title, _ = claude_title(source)
    blocks, more = render_claude(source)
    head = ["# Claude Code session", "",
            "- Session: %s (`%s`)" % (title or "untitled", source.stem),
            "- Folder: %s" % (session_cwd(source) or "?"),
            "- The whole transcript: %s" % source]
    parts = ["\n".join(head)]
    if summary:
        parts.append("## Claude's summary of the earlier work\n\n" + summary.strip())
    parts.append("## The most recent part" + (" (earlier turns left out)" if more else "")
                 + "\n\n" + "\n\n".join(blocks))
    HANDOFFS.mkdir(parents=True, exist_ok=True)
    out = HANDOFFS / ("%s-%s.md" % (datetime.datetime.now().strftime("%Y%m%d-%H%M"), source.stem))
    out.write_text("\n\n---\n\n".join(parts) + "\n")
    return out


def cmd_to_codex(args):
    show = "--print" in args
    rest = [a for a in args if a != "--print"]
    cwd = Path.cwd().resolve()
    source = find_claude_session(rest[0] if rest else None, cwd).resolve()
    work = session_cwd(source) or cwd
    if not work.is_dir():
        work = cwd
    tokens, summary = claude_size(source)
    if tokens > IMPORT_MAX_TOKENS:
        # Codex reads ~272k tokens; a bigger import can't even be compacted, so every turn fails
        out = claude_handoff(source, summary)
        print("This conversation is ~%dk tokens, more than Codex can take whole, so Codex starts "
              "fresh on Claude's summary plus the recent part (%s)." % (tokens // 1000, out))
        prompt = ("I'm switching to you from a Claude Code session in this folder. It is too long to "
                  "import whole, so here is Claude's summary of the earlier work plus the most recent "
                  "part: %s. Read it, then tell me in a few lines where that session left off and "
                  "what is still open. Don't start new work until I say so." % out)
        return launch(["codex", "-p", ASTRA_PROFILE, prompt], work, show)
    print("Importing Claude session %s (~%dk tokens) into Codex..." % (source.stem, tokens // 1000))
    with AppServer(work) as srv:
        srv.request("externalAgentConfig/import", {"migrationItems": [{
            "itemType": "SESSIONS",
            "description": "Transfer Claude session " + source.name,
            "cwd": None,
            "details": {"plugins": [], "sessions": [{"path": str(source), "cwd": str(work),
                                                     "title": None}],
                        "mcpServers": [], "hooks": [], "subagents": [], "commands": []}}]})
        done = srv.wait_for("externalAgentConfig/import/completed", timeout=120)
    for result in done.get("itemTypeResults") or []:
        for failure in result.get("failures") or []:
            raise BridgeError("Codex could not import the session: %s" % failure.get("message"))
    thread = imported_thread(source)
    if not thread:
        raise BridgeError("Codex found nothing to import in %s (a session with no "
                          "messages yet?)" % source.name)
    return launch(["codex", "resume", "-p", ASTRA_PROFILE, thread], work, show)


def cmd_to_claude(args):
    show = "--print" in args
    no_pull = "--no-pull" in args
    rest = [a for a in args if a not in ("--print", "--no-pull")]
    cwd = Path.cwd().resolve()
    text, thread, work = codex_transcript(cwd, rest[0] if rest else None)
    when = datetime.datetime.fromtimestamp(thread.get("updatedAt") or time.time())
    HANDOFFS.mkdir(parents=True, exist_ok=True)
    out = HANDOFFS / ("%s-%s.md" % (when.strftime("%Y%m%d-%H%M"), thread["id"]))
    out.write_text(text)
    print("Saved the Codex transcript to %s" % out)

    key = project_key(project_root(work))
    if not no_pull and pending(key):
        pull([key], dry_run=show)

    prompt = ("I'm switching to you from a Codex (GPT) session in this folder. Its "
              "transcript is at %s. Read it, then tell me in a few lines where that "
              "session left off and what is still open. Don't start new work until I "
              "say so." % out)
    return launch(["claude", "--add-dir", str(HANDOFFS), prompt], work, show)


def launch(cmd, cwd, show):
    if show:
        print("cd %s && %s" % (shell_quote(str(cwd)), " ".join(shell_quote(c) for c in cmd)))
        return 0
    os.chdir(str(cwd))
    os.execvp(cmd[0], cmd)


def shell_quote(s):
    return s if re.match(r"^[A-Za-z0-9_./:=@%+-]+$", s) else "'" + s.replace("'", "'\\''") + "'"


