            print("No new Codex memories%s." % ("" if "--all" in args else " for " + str(root)))
            return 0
        pull(keys, dry)
        return 0
    if sub == "show":
        sys.stdout.write(codex_context(cwd))
        return 0
    raise BridgeError("unknown mem command: %s (status, pull, show)" % sub)


